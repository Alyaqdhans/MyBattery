<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Portrait on phones is deliberate. Android 16+ ignores the lock on tablets and foldables,
        which the layouts already handle. Remove screenOrientation to allow rotation everywhere.
    -->
    <application
        android:name=".MyBatteryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyBattery"
        tools:ignore="DiscouragedApi,LockedOrientationActivity"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MyBattery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MyBattery" />

        <activity
            android:name=".LogRawActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MyBattery" />

    </application>
</manifest>