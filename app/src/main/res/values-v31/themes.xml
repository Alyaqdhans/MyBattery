<?xml version="1.0" encoding="utf-8"?>
<!--
    res/values-v31/themes.xml
    Android 12+ light mode: tints the launch window like the wallpaper-based Compose page.
    Android 11 and below never read this file.
-->
<resources>

    <style name="Theme.MyBattery" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@android:color/system_neutral2_10</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
